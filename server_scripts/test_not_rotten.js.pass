// ============================================================================
// 测试脚本：非腐败条件限制器在Create配方中的使用
// 使用Ingredient.of(物品类型, 数量)的方式实现多物品限制
// ============================================================================

ServerEvents.recipes(event => {
    console.info('[生物柴油修复测试] 开始测试非腐败条件限制器...');
    
    // 测试1：橄榄塑形配方（10个新鲜橄榄 → 800mb橄榄油）
    event.recipes.create.compacting(
        [Fluid.of('tfc:olive_oil', 800)],
        [
            Ingredient.of({
                type: 'tfc:and',
                children: [
                    { item: 'tfc:food/olive' },
                    { type: 'tfc:not_rotten' }
                ]
            }, 10)
        ],
        100
    ).id('kubejs:test_olive_to_oil_not_rotten');

    // 测试2：小麦面粉混合配方（16个新鲜小麦面粉 + 水 → 啤酒）
    event.recipes.create.mixing(
        [Fluid.of('tfc:beer', 1000)],
        [
            Ingredient.of({
                type: 'tfc:and',
                children: [
                    { item: 'tfc:food/wheat_flour' },
                    { type: 'tfc:not_rotten' }
                ]
            }, 16),
            Fluid.of('minecraft:water', 1000)
        ],
        100
    ).id('kubejs:test_wheat_flour_to_beer_not_rotten');

    // 测试3：小麦研磨配方（1个新鲜小麦种子 → 面粉）
    event.recipes.create.milling(
        ['tfc:food/wheat_flour'],
        [
            Ingredient.of({
                type: 'tfc:and',
                children: [
                    { item: 'tfc:food/wheat_grain' },
                    { type: 'tfc:not_rotten' }
                ]
            })
        ],
        50
    ).id('kubejs:test_wheat_grain_to_flour_not_rotten');

    console.info('[生物柴油修复测试] 所有配方创建完成！');
});
